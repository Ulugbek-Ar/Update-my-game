{
  "elder": {
    "start": "hello",
    "nodes": {
      "hello": {
        "text": [
          "Xush kelibsan, yo'lchi. Bu — Boshlang'ich vodiy.",
          "Bir paytlar bu yerda qal'a turgan, endi faqat xarobasi qoldi."
        ],
        "choices": [
          {
            "text": "Senga qanday yordam bera olaman?",
            "next": "boars-offer",
            "if": { "quest": "boars", "state": ["none"] }
          },
          {
            "text": "To'ng'izlarni haydab yubordim.",
            "next": "boars-done",
            "if": { "quest": "boars", "state": ["ready"] },
            "do": [{ "completeQuest": "boars" }]
          },
          {
            "text": "To'ng'izlar haqida...",
            "next": "boars-wait",
            "if": { "quest": "boars", "state": ["active"] }
          },
          {
            "text": "Yana ish bormi?",
            "next": "ruins-offer",
            "if": { "quest": "ruins", "state": ["none"] }
          },
          {
            "text": "Tosh yuraklarni olib keldim.",
            "next": "ruins-done",
            "if": { "quest": "ruins", "state": ["ready"] },
            "do": [{ "completeQuest": "ruins" }]
          },
          {
            "text": "Xarobalar haqida...",
            "next": "ruins-wait",
            "if": { "quest": "ruins", "state": ["active"] }
          },
          { "text": "Vodiy haqida gapirib ber.", "next": "lore" },
          { "text": "Xayr." }
        ]
      },
      "boars-offer": {
        "text": [
          "Yovvoyi to'ng'izlar dalalarimizni payhon qilmoqda.",
          "Daryo ortidagi o'tloqqa borib, 4 tasini yeng. Ehtiyot bo'l: tuyog'ini yerga ursa — hozir tashlanadi!"
        ],
        "choices": [
          { "text": "Mayli, qilaman.", "do": [{ "startQuest": "boars" }] },
          { "text": "Keyinroq." }
        ]
      },
      "boars-wait": {
        "text": [
          "To'ng'izlar eski ko'prikdan sharqdagi o'tloqda.",
          "Tashlanganda chetga o't — daraxtga urilsa, boshi aylanib qoladi."
        ],
        "choices": [{ "text": "Tushundim." }]
      },
      "boars-done": {
        "text": ["Rahmat, yo'lchi! Ol, yo'lda asqotadi."],
        "choices": [{ "text": "Rahmat.", "next": "hello" }]
      },
      "ruins-offer": {
        "text": [
          "Sharqdagi xarobalarda tosh askarlar qimirlay boshladi.",
          "Savdogar u yerda bo'lgan — avval u bilan gaplash. Keyin xarobani top va menga 2 ta Tosh yurak olib kel."
        ],
        "choices": [
          { "text": "Boraman.", "do": [{ "startQuest": "ruins" }] },
          { "text": "Hozir emas." }
        ]
      },
      "ruins-wait": {
        "text": [
          "Tosh askarlar haykal bo'lib turadi — yaqinlashsang uyg'onadi.",
          "Qo'llarini ko'tarsa, yerga urishidan oldin uzoqlash."
        ],
        "choices": [{ "text": "Yaxshi." }]
      },
      "ruins-done": {
        "text": [
          "Bu yuraklar hali iliq... Demak, Sardor uyg'ongan.",
          "Mana bu tumor ota-bobolarimdan qolgan. Senga ko'proq kerak."
        ],
        "choices": [{ "text": "Rahmat, oqsoqol.", "next": "hello" }]
      },
      "lore": {
        "text": [
          "Vodiy qadimiy yo'llar chorrahasida turibdi.",
          "Aytishlaricha, tunda xarobalarda oy nuri boshqacha tushar ekan..."
        ],
        "choices": [{ "text": "Qiziq.", "next": "hello" }]
      }
    }
  },
  "merchant": {
    "start": "hello",
    "nodes": {
      "hello": {
        "text": ["Keling, keling! Mollarim arzon, sifati — a'lo!"],
        "choices": [
          { "text": "Nimalar bor?", "do": [{ "shop": true }] },
          {
            "text": "Xarobalarda bo'lganmisan?",
            "next": "ruins",
            "if": { "quest": "ruins", "state": ["active", "ready", "done"] }
          },
          { "text": "Xayr." }
        ]
      },
      "ruins": {
        "text": [
          "Bo'ldim, xudo saqlasin! Ko'prikdan o'tib, yo'l bo'ylab sharqqa yuring.",
          "Ichkarida zirhli ulkan tosh jangchi bor — Xaroba Sardori. Unga yolg'iz bormang, shifo damlamasi oling."
        ],
        "choices": [
          { "text": "Damlama sotib olaman.", "do": [{ "shop": true }] },
          { "text": "Rahmat." }
        ]
      }
    }
  }
}
